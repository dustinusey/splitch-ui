{
  "name": "splitch-ui",
  "version": "0.1.0",
  "description": "splitch design system monorepo. Installing this repo from GitHub gives you @splitch/ui and the create-splitch-app CLI.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/ui",
    "packages/create-splitch-app",
    "apps/docs"
  ],
  "main": "./packages/ui/dist/index.js",
  "types": "./packages/ui/dist/index.d.ts",
  "exports": {
    ".": { "types": "./packages/ui/dist/index.d.ts", "import": "./packages/ui/dist/index.js" },
    "./styles.css": "./packages/ui/dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": ["*.css"],
  "bin": {
    "create-splitch-app": "packages/create-splitch-app/bin/create-splitch-app.js"
  },
  "files": [
    "packages/ui/dist",
    "packages/ui/CHANGELOG.md",
    "packages/create-splitch-app/bin",
    "packages/create-splitch-app/src",
    "templates/next-app"
  ],
  "scripts": {
    "build": "npm run build -w @splitch/ui && npm run build -w docs",
    "build:ui": "npm run build -w @splitch/ui",
    "dev": "npm run dev -w docs",
    "lint": "npm run lint -w docs",
    "typecheck": "npm run typecheck -w @splitch/ui",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.59.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true },
    "tailwindcss": { "optional": true }
  }
}
